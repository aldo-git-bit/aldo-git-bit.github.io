	title = {Surgery in language learning},
	url = {https://drive.google.com/file/d/1TMsxrh63jjed5Dea-wtng42_a_TpD05w/view?usp=drive_link},
	abstract = {This paper introduces a novel learning algorithm for phonological acquisition that addresses the challenge of simultaneously learning underlying forms and constraint rankings in Optimality Theory (OT). Using a simplified model called the PAKA system, the authors demonstrate how a learner can incrementally construct both a phonological grammar and lexicon through interaction between observed surface forms, ranking arguments, and hypothesis testing. Central to the approach is the strategy of prioritizing constraint reranking before altering underlying representations, with inconsistencies triggering targeted lexical modification. The algorithm employs Biased Constraint Demotion (BCD) to favor restrictive grammars and introduces a surgical updating mechanism that allows winner-loser pairs to remain valid across lexicon changes. Simulation results show the learner can efficiently converge on correct grammars across multiple languages with minimal grammar evaluations. This framework offers foundational insights into scalable models of learning in OT, particularly for properties like stress that exhibit both predictability and contrast.},
	booktitle = {Proceedings of the 22nd {West} {Coast} {Conference} on {Formal} {Linguistics}},
	publisher = {Cascadilla Press},
	author = {Tesar, Bruce and Alderete, John and Horwood, Graham and Merchant, Nazarré and Nishitani, Koichi and Prince, Alan},
	editor = {Gardin, G. and Tsujimura, M.},
	year = {2003},
	note = {tex.theme: computational-learning},
	keywords = {Optimality Theory, constraint ranking, phonological learning, stress assignment, underlying representation},
	pages = {477--490},
}

@article{tanaka_variation_2024,
	title = {The variation, change, and opacity of tone neutralization in {Cantonese}: {Its} ‘{Unity} in variety’ and implications for tone representation},
	volume = {28},
	url = {https://doi.org/10.24467/onseikenkyu.28.3_175},
	doi = {10.24467/onseikenkyu.28.3_175},
	abstract = {Pinjam is morphophonemic tone neutralization in Cantonese whose detailed facts have been described since Yue-Hashimoto (1972) and whose basic mechanism has been unveiled since Yip (1980). Subsequent studies have elaborated extensive analyses in various morphological alternations. However, dynamic facts about its variation and change have not been well understood. Also, the interaction between pinjam and tone sandhi is still a mystery that involves opacity. So our goal is to empirically validate new facts about its variation and change and show a unified model using Optimality Theory that accounts for the apparently chaotic phenomena including its opaque interactions with tone sandhi.},
	journal = {Journal of the Phonetic Society of Japan},
	author = {Tanaka, Shin-ichi and Alderete, John and Chan, Queenie},
	year = {2024},
	note = {tex.theme: constraint-optimization},
	keywords = {opacity, Optimality Theory, changed tones, pinjam, tone neutralization, tone sandhi, variation and change},
	pages = {175--189},
}

@article{kochetov_patterns_2011,
	title = {Patterns and scales of expressive palatalization: {Typological} and experimental evidence},
	volume = {56},
	url = {http://drive.google.com/file/d/1g2fMqASvUvsHJqdvkOXriL-9y-FOpxi1/view},
	doi = {10.1353/cjl.2011.0028},
	abstract = {This paper argues for a distinct treatment of expressive palatalization – an apparently phonologically unmotivated process that applies in babytalk registers, diminutive constructions, and sound symbolism. As evidence we present results of a cross-linguistic survey of expressive palatalization and of two experiments testing native speakers’ intuitions about alternations in Japanese mimetic vocabulary and the babytalk specialized register. Both typological and experimental results point to the same scale of palatalizability, with coronal sibilants being the most optimal targets and outputs of expressive palatalization. The source of this scale, we argue, is in relative acoustic salience of palatal(ized) consonants and their ability to function iconically – as phonological correlates of ‘smallness’ and ‘childishness’ (cf. Ohala 1994). We further provide an Output-Output Correspondence analysis of Japanese babytalk and mimetic palatalization that employs a set of register-specific EPAL ICONICITY constraints referring to the scale of perceptual salience of palatal(ized) consonants.},
	journal = {Canadian Journal of Linguistics},
	author = {Kochetov, Alexei and Alderete, John},
	year = {2011},
	note = {tex.theme: constraint-optimization, data-annotation},
	keywords = {palatalization, Japanese, cross-linguistic, expressive registers/vocabulary, phonetic scales},
	pages = {345--376},
}

@incollection{kim_why_2008,
	title = {Why [h] and aspirated consonants are different in {Korean}},
	volume = {28},
	url = {https://drive.google.com/file/d/16RegTrdZnFX0bDYZDyJJWtpniWIVENO5/view?usp=drive_link},
	abstract = {This paper examines the phonological processes affecting [h] and aspirated consonants in Korean and provides a comprehensive analysis in Optimality Theory. Following standard assumptions, [h] and aspirated consonants are treated as a class of aspirates and specified for the same laryngeal feature, e.g., [spread glottis]. Despite this formal similarity, they undergo different processes in the same syllabic positions, e.g., coda position and post-obstruent onset position. We argue that these facts require an analysis in which all coda aspirates violate a positional markedness constraint, but that [h] differs from aspirated consonants in lacking a surface place specification. In particular, placeless [h] is treated differently by faithfulness constraints, which makes it possible to account for the different processes it undergoes. Plausible alternations are also considered that employ various combinations of these assumptions with positional faithfulness constraints. This discussion shows the necessity of both positional markedness and the assumed placeless [h], because none of the alternatives can account for the full pattern in Korean.},
	booktitle = {Toronto {Working} {Papers} in {Linguistics}},
	author = {Kim, Lan and Alderete, John},
	year = {2008},
	note = {tex.theme: constraint-optimization},
	keywords = {phonology, positional neutralization, Korean, laryngeals},
	pages = {123--136},
}

