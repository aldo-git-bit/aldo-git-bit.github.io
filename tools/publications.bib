@article{alderete_reduplication_2015,
	title = {Reduplication in {Hawaiian}: {Variations} on a theme of minimal word},
	volume = {33},
	url = {https://drive.google.com/file/d/1pbA1kzt06UGcGhaPLDZpptO7fw9dJbMV/view},
	doi = {10.1007/s11049-014-9255-7},
	abstract = {The article explores a database of over 1600 reduplicated words in Hawaiian and gives the first comprehensive account of the empirical generalizations concerning reduplicant form and associated vowel length alternations. We argue that the observed output patterns and length alternations can be cogently analyzed by recognizing a minimal word target for reduplicant shape. Realizing a minimal word, or a single well-formed foot, is predicted by the integration of standard constraints on prosodic well-formedness and faithfulness constraints in Optimality Theory. We further show that all variant realizations of the reduplicant, and a myriad of exceptional patterns, can be accounted for by re-ordering only faithfulness constraints defined on distinct correspondence relations, documenting that one especially rich dataset can be analyzed with this limitation on constraint systems.},
	journal = {Natural Language and Linguistic Theory},
	author = {Alderete, John and MacMillan, Kayleigh},
	year = {2015},
	note = {tex.theme: constraint-optimization},
	keywords = {prosody, reduplication, Optimality Theory, Austronesian, generalized templates, minimal word, correspondence relations, exceptional phonology, nonconcatenative morphology, phonology of length, Polynesian},
	pages = {1--45},
}

@article{alderete_integrating_2017,
	title = {Integrating sound symbolism with core grammar: {The} case of expressive palatalization},
	volume = {93},
	url = {https://drive.google.com/file/d/14SwTIQGmOVQe15IbHU_7fs6jT3c5sSO3/view},
	doi = {10.1353/lan.2017.0056},
	abstract = {Fifty cases of sound-symbolic expressive palatalization were collected in a typological survey of babytalk registers, diminutive constructions, and other sound-symbolic systems. Analysis of the typological trends and language-particular examples reveals important differences between expressive palatalization and phonologically motivated palatalization. To account for expressive palatalization, we propose a novel set of Express(X) constraints in optimality theory. The integration of the Express(X) constraints with the rest of phonology is shown to explain the typological differences between expressive and phonological palatalization, account for the phonological extension of expressive palatalization, and constitute a general theoretical framework for sound-symbolic phonological patterns.},
	journal = {Language},
	author = {Alderete, John and Kochetov, Alexei},
	year = {2017},
	note = {tex.theme: constraint-optimization},
	keywords = {palatalization, expressive phonology and morphology, optimality theory, sound symbolism, typology},
	pages = {731--766},
}

@article{alderete_japanese_2009,
	title = {Japanese mimetic palatalization revisited: impilcations for conflicting directionality},
	volume = {26},
	url = {https://drive.google.com/file/d/1R9LV3jvHDPSJ844St2V06mB4g1VcmCXG/view},
	doi = {10.1017/S0952675709990212},
	abstract = {This article re-examines ‘conflicting directionality’ in Japanese mimetic words, a distributional pattern in which palatalisation is preferentially realised on the rightmost of two coronal consonants, but on the leftmost consonant in a word without coronals. Analysis of the original dictionary evidence given in support of this generalisation and an exhaustive search of the Japanese mimetic stratum reveal both several counterexamples to conflicting directionality and the fact that the datasets are far too small to support linguistic generalisation. The theoretical assumptions employed to account for Japanese mimetic palatalisation are thus re-examined, with a focus on clarifying the predictions for future valid examples of conflicting directionality.},
	journal = {Phonology},
	author = {Alderete, John and Kochetov, Alexei},
	year = {2009},
	note = {tex.theme: constraint-optimization},
	keywords = {directionality, Japanese, alignment, coronals, mimetics},
	pages = {369--388},
}

@incollection{de_lacy_dissimilation_2007,
	address = {Cambridge},
	title = {Dissimilation in grammar and the lexicon},
	url = {https://drive.google.com/file/d/1OsYRB3lbGs6rUD7l2AFmv5jD4tCiE-Pz/view},
	doi = {10.1017/CBO9780511486371.017},
	abstract = {This chapter investigates dissimilation, the phonological phenomenon whereby similar sounds are systematically avoided in proximity, analyzing it through grammatical, lexical, historical, and statistical lenses. The authors review cross-linguistic evidence distinguishing between dynamic dissimilation processes and static lexical patterns, highlighting features most commonly implicated (e.g., place, laryngeals, and liquids) and the locality and domain constraints that condition their application. Historical accounts, particularly Ohala’s hypercorrection model, are assessed for their explanatory scope and limitations. Generative analyses, including autosegmental phonology and Optimality Theory, are shown to model categorical dissimilation effects effectively, while probabilistic approaches reveal gradient patterns tied to phonological similarity. These findings underscore the need for integrative models that accommodate both symbolic and statistical generalizations in grammar, particularly in reconciling lexical distribution patterns with productive phonological alternations.},
	booktitle = {The {Cambridge} handbook of phonology},
	publisher = {Cambridge University Press},
	author = {Alderete, John and Frisch, Stefan A.},
	editor = {de Lacy, Paul},
	year = {2007},
	note = {tex.theme: constraint-optimization},
	keywords = {dissimilation, dynamic vs. static, gradience, hypercorrection, probablistic phonology, typology},
	pages = {379--398},
}

@article{alderete_probabilistic_2023,
	title = {Probabilistic phonology: {A} review of theoretical perspectives, applications, and problems},
	volume = {24},
	url = {https://www.jbe-platform.com/content/journals/10.1075/lali.00141.ald},
	doi = {10.1075/lali.00141.ald},
	abstract = {Probability and frequency are becoming increasingly important in phonological analysis. This article reviews contemporary perspectives on how phonological theory addresses gradient phonological patterns shaped by probability and frequency, drawing on theories of the lexicon, grammar, and statistics. After examining their motivations, we show how these diverse theoretical perspectives have been applied to a variety of problems in core phonology, including phonotactics, morphophonology, sound change, phonological categorization, and language development. Our review of theory and applications supports a growing consensus in the field that phonological theories must reckon with probability. Our review also identifies problems stemming from a lack of cohesion in the field, and suggests potential solutions to these problems.},
	journal = {Language and Linguistics},
	author = {Alderete, John and Finley, Sara},
	year = {2023},
	note = {tex.theme: constraint-optimization, AI},
	keywords = {connectionism, frequency, gradience, constraint-based grammar, exemplar theory, information theory, probability},
	pages = {565--610},
}

@article{alderete_gradient_2016,
	title = {Gradient vowel harmony in {Oceanic}},
	volume = {17},
	url = {https://drive.google.com/file/d/1B56SxMmBjCExwgdFEp48H1J4edeuNORY/view},
	doi = {10.1177/1606822X16660960},
	abstract = {This article contributes to the understanding of gradient phonological patterns by investigating graded vowel co-occurrence in Oceanic languages. In particular, vowel co-occurrence patterns in disyllabic stems are investigated in four languages: Samoan, Tongan, Hawaiian, and Fijian, as well as reconstructed forms in Proto-Oceanic and Proto-Malayo-Polynesian. With some variation in degree, all languages exhibit an over-representation of identical vowel pairs (e.g. i–i), an under-representation of similar vowel pairs (i–e), and no special restrictions on dissimilar vowel pairs (e.g. i–o). These graded restrictions are also subject to order effects in all languages because the dissimilar {\textgreater} similar inequality in frequency is only found in certain orders. Our focus is on documenting the patterns supporting these generalizations so that future theoretical analysis will rest on strong empirical ground. In addition, we propose one such analysis using gradient constraints on parasitic vowel harmony.},
	journal = {Language and Linguistics},
	author = {Alderete, John and Finley, Sara},
	year = {2016},
	note = {tex.theme: constraint-optimization, data-annotation},
	keywords = {vowel harmony, Austronesian, gradient patterns, parasitic harmony},
	pages = {769--796},
}

@article{alderete_morphology_2022,
	title = {The morphology of {Cantonese} “changed tone”: {Extensions} and limitations},
	volume = {161},
	url = {https://www.ls-japan.org/modules/documents/LSJpapers/journals/161_alderete.pdf},
	doi = {10.11435/gengo.161.0_139},
	abstract = {Cantonese substitutes a base tone with either a high-level or high-rising tone in certain derived environments, a kind of process morphology dubbed pinjam (變音) “changed tone”. We develop a comprehensive analysis of Cantonese pinjam morphology that predicts this tonal change as the realization of a tonal affix that is shaped by both language particular patterns and universal constraints. The predictions of this core analysis are then used to explore a range of morphological and syntactic constructions that also have a pinjam, but have not been fully analyzed in prior research. This investigation also makes an empirical contribution by showing how the core analysis can extend naturally to many under-studied constructions, as well as documenting some of the limits of this analysis.},
	journal = {Gengo Kenkyu},
	author = {Alderete, John and Chan, Queenie and Tanaka, Shin-ichi},
