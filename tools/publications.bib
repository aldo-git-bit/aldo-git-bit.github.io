@incollection{hsiao_reduplication_2015,
	address = {Newcastle},
	title = {Reduplication in {Rotuman}: {A} curious case of emergent unmarkedness},
	url = {https://drive.google.com/file/d/15Dpn8pd_A6lODi2bRW_sLIpjRAFe_ErK/view},
	abstract = {This article gives a comprehensive analysis of reduplication in Rotuman (Oceanic). The main reduplication
shape is a heavy syllable prefix (e.g., CVC-, CVV-), which we document with a list of 847 reduplicated words and native
speaker elicitation. We argue that the heavy syllable shape is predicted in large part by the phonology of the incomplete phase, a system-wide generalization also requiring heavy syllables. The apparent markedness of the reduplicant thus follows from the phonology of phase and other independently motivated constraints for anti-gemination, under-application, and prosodic faithfulness effects.},
