@incollection{alderete_contrast_2005,
	address = {Somerville, MA},
	title = {Contrast {Analysis} {Aids} the {Learning} of {Phonological} {Underlying} {Forms}},
	url = {https://drive.google.com/file/d/1sMcg4CnF3DeZL3GoOItpPpnAFYgG2Tal/view?usp=drive_link},
	abstract = {This paper investigates how surface contrast in phonological data can inform the acquisition of underlying representations, particularly in the context of Optimality Theory. The authors introduce a learning model that integrates contrast analysis with existing algorithms for constraint ranking (Biased Constraint Demotion) and phonotactic learning. Central to the approach is the concept of Faithful Contrastive Features (FCFs), where surface contrasts that are demonstrably faithful to underlying forms can be used to fix values in the underlying lexicon. Using a simple linguistic system with stress and vowel length features, the authors show how contrast pairs can reduce the hypothesis space of possible underlying forms by identifying unique FCFs. Simulations over a typology of 24 languages reveal that contrast analysis significantly complements phonotactic learning, particularly in systems with lexical stress, by enabling more efficient convergence on accurate grammars. These findings support a modular but integrated approach to phonological learning that leverages both surface distributional patterns and contrastive alternations.},
	booktitle = {Proceedings of the 24th {West} {Coast} {Conference} on {Formal} {Linguistics}},
	publisher = {Cascadilla Proceedings Project},
	author = {Alderete, John and Brasoveanu, Adrian and Merchant, Nazarré and Prince, Alan and Tesar, Bruce},
	editor = {Alderete, John and Han, Chung-Hye and Kochetov, Alexei},
	year = {2005},
	note = {tex.theme: computational-learning},
	keywords = {Optimality Theory, phonological learning, contrast analysis, faithfulness constraints, underlying forms},
	pages = {34--42},
}

@article{alderete_samoan_2013,
	title = {Samoan root phonotactics: {Digging} deeper into the data},
	volume = {11},
	url = {10.1349/PS1.1537-0852.A.424},
	doi = {10.1349/PS1.1537-0852.A.424},
	abstract = {This article gives a detailed quantitative account of Samoan root phonotactics. In particular, count data is given in eleven tables of segment frequencies (i.e., consonants, short and long vowels, diphthongs) and frequencies of combinations of segments (i.e., syllable types, consonant-vowel combinations, V-V and C-C combinations across syllables). Systematic patterns of over- and under-representation of these structures in the lexicon are documented and related to prior research. Beyond the detailed frequency facts presented here, new empirical patterns documented include positional preferences for bilabials and non-labial sonorants, extensions of a known pattern of gradient vowel assimilation, and identification of a role for manner and segment order in consonant co-occurrence restrictions.},
	journal = {Linguistic Discovery},
	author = {Alderete, John and Bradshaw, Mark},
	year = {2013},
	note = {tex.theme: data-annotation},
	keywords = {phonotactics, sound frequency, Samoan, gradience, positional restrictions},
	pages = {1--21},
}

@article{alderete_reduplication_1999,
	title = {Reduplication with fixed segmentism},
	volume = {30},
	url = {https://direct.mit.edu/ling/article-abstract/30/3/327/52/Reduplication-with-Fixed-Segmentism?redirectedFrom=fulltext},
	doi = {10.1162/002438999554101},
	abstract = {Fixed segmentism is the phenomenon whereby a reduplicative morpheme contains segments that are invariant rather than copied. We investigate it within Optimality Theory, arguing that it falls into two distinct types, phonological and morphological. Phonological fixed segmentism is analyzed under the OT rubric of emergence of the unmarked. It therefore has significant connections to markedness theory, sharing properties with other domains where markedness is relevant and showing context-dependence. In contrast, morphological fixed segmentism is a kind of affixation, and so it resembles affixing morphology generally. The two types are contrasted, and claims about impossible patterns of fixed segmentism are developed.},
	journal = {Linguistic Inquiry},
	author = {Alderete, John and Beckman, Jill and Benua, Laura and Gnanadesikan, Amalia and McCarthy, John and Urbanczyk, Suzanne},
	year = {1999},
	note = {tex.theme: constraint-optimization},
	keywords = {correspondence, Optimality Theory, markedness, default, inventory, prosodic morphology},
	pages = {327--364},
}

@inproceedings{alderete_agreement_2021,
	title = {Agreement errors and language production processes: {Building} a taxonomy of error types from spontaneous speech data},
	url = {https://drive.google.com/file/d/1Hq9xH87rotDs1mGVOnykHujHWt_oh24h/view},
	abstract = {This poster presents a corpus-based study of morpho-syntactic agreement errors in spontaneous English speech, drawing on the SFUSED English 1.0 database. The study aims to build a comprehensive taxonomy of error types and connect these patterns to psycholinguistic models of grammatical encoding, particularly the Bock and Levelt (1994) consensus model. While morpho-syntactic speech errors have been extensively examined in experimental settings, their classification and interpretation in natural speech remain underdeveloped. Using dual-coded audio recordings and a validated error taxonomy, the researchers analyze phenomena such as bare form defaults, past tense substitutions, and notional number mismatches. Some expected processing preferences (e.g., defaults) are supported, while others (e.g., plural attraction) are less evident, suggesting nuanced influences of sentence-level structure and conceptual number. These findings provide empirical grounding for theoretical accounts of agreement processing and advance error classification methodologies in language production research.},
	publisher = {The Psychonomic Society},
	author = {Alderete, John and Baese-Berk, Melissa and Li, Jane SY},
	year = {2021},
	note = {tex.theme: psycholinguistics},
	keywords = {speech errors, language production, agreement, morpho-syntax, spontaneous speech},
}

@article{alderete_new_2023,
	title = {A new corpus of lexical substitution and word blend errors: {Probing} the semantic structure of lemma access failures},
	volume = {26},
	url = {https://journalofcognition.org/articles/10.5334/joc.278},
	doi = {10.5334/joc.278},
	abstract = {Models of lemma access in language production predict occasional mis-selection of lemmas linked to highly similar concepts (synonyms) and concepts standing in a set-superset relation (subsumatives). It is unclear, however, if such errors occur in spontaneous speech, and if they do, whether humans can detect them given their minimal impact on sentence meaning. This data report examines a large corpus of English spontaneous speech errors and documents a low but non-negligible occurrence of these categories. The existence of synonym and subsumative errors is documented in a larger open access data set that supports a range of new investigations of the semantic structure of lexical substitution and word blend speech errors.},
	journal = {Journal of Cognition},
	author = {Alderete, John and Baese-Berk, Melissa and Brasoveanu, Adrian and Law, Jess H. K.},
	year = {2023},
	note = {tex.theme: psycholinguistics, data-annotation},
	keywords = {speech errors, lemma selection, lexical substitutions, semantic processing, word blends},
	pages = {1--8},
}

