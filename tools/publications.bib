@article{alderete_structural_2003,
	title = {Structural disparities in {Navajo} word domains: {A} case for lex-cat faithfulness},
	volume = {20},
	url = {https://drive.google.com/file/d/1EAGBHAVQsKMacWboAFwcFwsbEMUQ61vu/view},
	doi = {10.1515/tlir.2003.006},
	abstract = {This article gives a comprehensive analysis of the phonology of Navajo verbs in Optimality Theory based on the leading ideas of Positional Faithfulness (PF) Theory (Beckman 1998). In particular, faithfulness constraints are segregated according to whether they target lexical or functional categories in the morpho-syntax, and the two resulting constraint types are employed in the analysis of the word domains created by this division. The PF analysis explains the observed differences between so-called conjunct prefixes, on the one hand, and disjunct prefixes and stems, on the other, which are classified in Athabaskan linguistics as func-cats and lex-cats, respectively (Rice 2000). PF provides a direct account of the structural disparities between these domains, as exhibited both by their phonological make-up and the occurrence of phonological alternations. These results distinguish the PF analysis from a plausible alternative employing Positional Markedness (Steriade 1999, Zoll 1998).},
	journal = {The Linguistic Review},
	author = {Alderete, John},
	year = {2003},
	note = {tex.theme: constraint-optimization, data-annotation},
	keywords = {phonology, positional faithfulness, lexical categories, Navajo, verbs},
	pages = {111--158},
}

@incollection{frawley_phonological_2003,
	address = {Oxford},
	title = {Phonological processes: {Dissimilation}},
	url = {https://drive.google.com/file/d/1mm-CySRs-tGlkPH6qZXFgUmElwfWCOUs/view?usp=drive_link},
	abstract = {This article provides a concise overview of dissimilation, a phonological process in which similar segments are systematically avoided within a word or morpheme domain. Drawing on data from languages such as Tashlhiyt Berber, Arabic, and Japanese, the paper distinguishes between dynamic dissimilatory alternations and static lexical restrictions, and critically evaluates theoretical accounts across phonological frameworks. The autosegmental analysis models dissimilation as feature delinking governed by the Obligatory Contour Principle (OCP), while the Optimality Theory (OT) perspective interprets dissimilation as a result of cumulative markedness constraints, especially through constraint conjunction. These approaches are shown to explain both local and long-distance dissimilation effects and feature-specific behavior (e.g., labials vs. coronals). The paper concludes that dissimilation reveals crucial interactions between feature specification, phonological activity, and constraint-based markedness hierarchies.},
	booktitle = {International {Encyclopedia} of {Linguistics}},
	publisher = {Oxford University Press},
	author = {Alderete, John},
	editor = {Frawley, William},
	year = {2003},
	note = {tex.theme: constraint-optimization},
	keywords = {dissimilation, Optimality Theory, autosegmental phonology, Obligatory Contour Principle, phonological markedness},
	pages = {323--324},
}

